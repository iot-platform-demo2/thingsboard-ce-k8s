# # Database used by ThingsBoard, can be either postgres (PostgreSQL) or hybrid (PostgreSQL for entities database and Cassandra for timeseries database).
# # According to the database type corresponding kubernetes resources will be deployed (see postgres.yml, cassandra.yml for details).
# DATABASE=postgres

# # Replication factor for Cassandra database (will be ignored if PostgreSQL was selected as the database).
# # Must be less or equals to the number of Cassandra nodes which can be configured in ./common/cassandra.yml ('StatefulSet.spec.replicas' property)
# CASSANDRA_REPLICATION_FACTOR=1
#
# # Public host used by the k3s ingress for the ThingsBoard UI and REST API.
# # Point your DNS record to the k3s node or external load balancer IP before deploy.
# TB_PUBLIC_HOST=iot-thingboard.vn
#
# # Ingress class to use for HTTP access. Set this to nginx when using ingress-nginx on k3s.
# TB_INGRESS_CLASS_NAME=nginx
#
# # TLS secret and cert-manager ClusterIssuer used for the public domain.
# # Requires cert-manager and a working ClusterIssuer on the cluster.
# TB_TLS_SECRET_NAME=tb-ingress-tls
# TB_TLS_CLUSTER_ISSUER=letsencrypt-prod
# TB_SSL_REDIRECT=true
#
# # Service type for external device transports on k3s.
# TB_MQTT_SERVICE_TYPE=LoadBalancer
# TB_COAP_SERVICE_TYPE=LoadBalancer

DATABASE=hybrid
CASSANDRA_REPLICATION_FACTOR=1
TB_PUBLIC_HOST=things.iot-platform.io.vn
TB_INGRESS_CLASS_NAME=nginx
TB_TLS_SECRET_NAME=tb-ingress-tls
TB_TLS_CLUSTER_ISSUER=letsencrypt-prod
TB_TLS_ACME_EMAIL=gpt.htv@gmail.com
TB_TLS_ACME_SERVER=https://acme-v02.api.letsencrypt.org/directory
TB_SSL_REDIRECT=true
TB_MQTT_SERVICE_TYPE=LoadBalancer
TB_COAP_SERVICE_TYPE=LoadBalancer